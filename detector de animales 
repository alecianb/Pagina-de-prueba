        "# Subimos una fotografía desde nuestra computadora.\n",
        "archivos = files.upload()\n",
        "\n",
        "for ruta_imagen in archivos:\n",
        "    path_original = Path(ruta_imagen)\n",
        "\n",
        "    # Si la extensión es .jfif, la convertimos a .jpg usando OpenCV para evitar errores con YOLO\n",
        "    if path_original.suffix.lower() == '.jfif':\n",
        "        temp_img = cv2.imread(ruta_imagen)\n",
        "        ruta_imagen = str(path_original.with_suffix('.jpg'))\n",
        "        cv2.imwrite(ruta_imagen, temp_img)\n",
        "\n",
        "    # Detectamos objetos con una confianza mínima del 30 % usando YOLO\n",
        "    resultados = modelo.predict(\n",
        "        source=ruta_imagen,\n",
        "        conf=0.30,\n",
        "        verbose=False\n",
        "    )\n",
        "\n",
        "    perfiles_a_mostrar = set()\n",
        "\n",
        "    # Procesamos las detecciones del modelo\n",
        "    for resultado in resultados:\n",
        "        for caja in resultado.boxes:\n",
        "            indice = int(caja.cls[0])\n",
        "            nombre_detectado = resultado.names[indice].lower()\n",
        "            confianza = float(caja.conf[0])\n",
        "\n",
        "            print(f\"Detectado: {nombre_detectado} | Confianza: {confianza:.1%}\")\n",
        "\n",
        "            if nombre_detectado in ANIMALES:\n",
        "                info_animal = ANIMALES[nombre_detectado]\n",
        "                perfiles_a_mostrar.add(info_animal[\"perfil\"])\n",
        "                print(f\"-> Categoría: {', '.join(info_animal['grupos'])} ({info_animal['nombre']})\")\n",
        "\n",
        "    # Guardamos y mostramos la imagen con las detecciones dibujadas\n",
        "    imagen_anotada = resultados[0].plot()\n",
        "    ruta_salida = \"resultado.jpg\"\n",
        "    cv2.imwrite(ruta_salida, imagen_anotada)\n",
        "\n",
        "    display(Image(filename=ruta_salida))\n",
        "\n",
        "    # Mostramos las recomendaciones de cuidados según el perfil detectado\n",
        "    for perfil in perfiles_a_mostrar:\n",
        "        datos_cuidado = CUIDADOS[perfil]\n",
        "        print(f\"\\n=== {datos_cuidado['titulo'].upper()} ===\")\n",
        "\n",
        "        print(\"\\nCuidados generales:\")\n",
        "        for cuidado in datos_cuidado[\"cuidados\"]:\n",
        "            print(f\"- {cuidado}\")\n",
        "\n",
        "        print(\"\\nAlimentación recomendada:\")\n",
        "        for alimentacion in datos_cuidado[\"alimentacion\"]:\n",
        "            print(f\"- {alimentacion}\")\n",
        "\n",
        "    if not perfiles_a_mostrar:\n",
        "        print(\"\\nNo se detectaron animales compatibles en esta imagen.\")"
